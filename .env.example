# Optional shell environment overrides; no secrets are required.
# This file is documentation, not automatically loaded by npm/dev/start.
# Export only the settings needed on your own machine.

# JAVA_HOME=/path/to/complete-jdk
# GGJAVA_WORKSPACE=.ggjavaez
# GGJAVA_MAVEN_PATH=/path/to/mvn
# GGJAVA_GRADLE_PATH=/path/to/gradle
# GGJAVA_JDTLS_HOME=/path/to/verified-jdtls-distribution
# Keep the default bridge port for the default Vite proxy.
# GGJAVA_PORT=8787
