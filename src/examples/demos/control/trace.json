    {
      "fileId": "Main.java",
      "name": "Main.java",
      "content": "import java.util.Scanner;\n\npublic class Main {\n    static int clamp(int value) {\n        if (value < 0) {\n            int corrected = 0;\n            return corrected;\n        } else if (value > 100) {\n            int corrected = 100;\n            return corrected;\n        } else {\n            int corrected = value;\n            return corrected;\n        }\n    }\n\n    public static void main(String[] args) {\n        Scanner input = new Scanner(System.in);\n        int total = 0;\n        for (int i = 0; i < 3; i++) {\n            int raw = input.nextInt();\n            int score = clamp(raw);\n            total += score;\n            System.out.println(score);\n        }\n        System.out.println(total);\n    }\n}\n"
    }
  ],
