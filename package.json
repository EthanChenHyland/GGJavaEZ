{
  "name": "visual-java",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=1 --fileParallelism=false",
    "test:acceptance": "VJ_SUITE=acceptance vitest run tests/acceptance --maxWorkers=1 --fileParallelism=false",
    "perf:baseline": "VJ_SUITE=perf vitest run tests/perf --maxWorkers=1 --fileParallelism=false",
    "test:e2e": "playwright test",
    "perf:browser": "playwright test --config playwright.perf.config.ts",
    "capture:visual": "node scripts/capture-visual.mjs",
    "lint": "eslint src"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.48.0",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
